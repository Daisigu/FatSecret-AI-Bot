[Unit]
Description=FatSecret Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/fatsecret-voice-bot
Environment=NVM_DIR=/root/.nvm
ExecStart=/bin/bash -c 'source /root/.nvm/nvm.sh && exec node --env-file=.env src/index.ts'
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
