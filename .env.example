# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:AA...
# Comma-separated list of Telegram numeric user IDs allowed to use the bot (just you).
# Send /id to the bot once (without this set) to discover your ID, or check @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- Gemini ---
GEMINI_API_KEY=AIza...
# Comma-separated fallback pool (tried in order, max 3). Each model has its own quota.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# --- FatSecret ---
# From https://platform.fatsecret.com -> your application
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
# Filled in automatically by `npm run fatsecret:auth` (one-time 3-legged OAuth 1.0a setup)
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_TOKEN_SECRET=

# --- Misc ---
# IANA timezone used to decide the "day" and the meal (breakfast/lunch/dinner/other)
TIMEZONE=Europe/Moscow
