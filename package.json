{
  "name": "fatsecret-voice-bot",
  "version": "1.0.0",
  "description": "Telegram bot: voice message -> Gemini (STT + parsing) -> FatSecret food diary",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "fatsecret:auth": "node --env-file=.env src/fatsecret-oauth-setup.ts"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "grammy": "^1.46.0",
    "oauth-1.0a": "^2.2.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.12"
  }
}
